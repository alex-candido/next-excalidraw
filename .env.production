# App
NEXT_PUBLIC_APP_URL=

# Database (libsql/Turso)
# Local: file:./local.db | Turso: libsql://<db-name>.turso.io
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/nextexcalidraw_db

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3-flash-preview
BETTER_AUTH_SECRET=

# Object storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=